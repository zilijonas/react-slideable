{
  "name": "react-slideable",
  "version": "2.0.1",
  "description": "A lightweight React carousel and slider with smooth touch dragging, responsive slides, infinite loops, autoplay and CSS styling. TypeScript ready; zero runtime dependencies.",
  "homepage": "https://zilijonas.github.io/react-slideable/",
  "bugs": {
    "url": "https://github.com/zilijonas/react-slideable/issues"
  },
  "author": "zilijonas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zilijonas/react-slideable.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "react",
    "carousel",
    "slider",
    "react-carousel",
    "react-slider",
    "responsive-carousel",
    "image-carousel",
    "touch-slider",
    "swipe",
    "drag",
    "autoplay",
    "infinite-carousel",
    "typescript",
    "css",
    "accessibility",
    "keyboard-navigation",
    "zero-dependencies",
    "scroll-snap",
    "infinite",
    "slideable"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --minify --clean --external react --external react/jsx-runtime && node scripts/copy-css.mjs",
    "dev": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run demo:build && npm run test:browser",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.9",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
